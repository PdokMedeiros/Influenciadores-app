# Template de variáveis de ambiente — copie para .env na raiz do projeto
# e preencha os valores reais. NUNCA commite o .env real no git.

# --- Aplicação ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Banco de dados (PostgreSQL local para dev, gerado pelo provision.sh em prod) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/influenciadores_dev

# --- Redis (local para dev, gerado pelo provision.sh em prod) ---
# REDIS_URL=redis://localhost:6379
# (não é obrigatório em Phase 0, será usado a partir de Phase 4 para BullMQ)

# --- Auth.js / NextAuth (sessão dos usuários internos) ---
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Criptografia dos tokens OAuth das redes sociais (AES-256-GCM) ---
# Gere com: openssl rand -hex 32
# (necessário para Phase 5 quando implementar OAuth)
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- Object storage externo (mídia kit, comprovantes — Phase 3 em diante) ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- OAuth por plataforma (Phase 5 em diante) ---
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- YouTube Data API v3 (métricas públicas — Phase 5 em diante) ---
# YOUTUBE_DATA_API_KEY=
